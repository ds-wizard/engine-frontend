{
  "name": "engine-frontend",
  "repository": "https://github.com/ds-wizard/engine-frontend",
  "license": "Apache-2.0",
  "scripts": {
    "replace-kernel-packages": "ELM_HOME=$PWD/elm-stuff/elm-home node packages/elm-kernel-replacements/replace-kernel-packages.mjs",
    "start": "ELM_HOME=$PWD/elm-stuff/elm-home COMPONENT=dsw webpack serve",
    "start:dsw": "ELM_HOME=$PWD/elm-stuff/elm-home COMPONENT=dsw webpack serve",
    "start:registry": "ELM_HOME=$PWD/elm-stuff/elm-home COMPONENT=registry webpack serve",
    "build": "npm run build:dsw && npm run build:registry",
    "build:dsw": "ELM_HOME=$PWD/elm-stuff/elm-home COMPONENT=dsw ./tools/build/build.sh",
    "build:registry": "ELM_HOME=$PWD/elm-stuff/elm-home COMPONENT=registry ./tools/build/build.sh",
    "clean": "rm -rf dist",
    "pot": "npm run pot:dsw",
    "pot:dsw": "COMPONENT=dsw node tools/i18n/create-pot-file.js",
    "test": "npm run test:elm && npm run test:checks && npm run test:ui",
    "test:elm": "ELM_HOME=$PWD/elm-stuff/elm-home elm-test test/elm",
    "test:checks": "npm run test:guide-links && npm run test:ui-styles",
    "test:guide-links": "node tools/checks/guide-links.js",
    "test:ui-styles": "node tools/checks/ui-styles.js",
    "test:ui": "npm run test:ui-ports && npm run test:ui-date-picker && npm run test:ui-markdown-editor && npm run test:ui-code-editor && npm run test:ui-chart && npm run test:ui-list-field && npm run test:ui-suggest-input && npm run test:ui-menu-fit && npm run test:ui-form-errors",
    "test:ui-ports": "node packages/elm-ui/tests/ports.test.js",
    "test:ui-date-picker": "node packages/elm-ui/tests/date-picker.test.js",
    "test:ui-markdown-editor": "node packages/elm-ui/tests/markdown-editor.test.js",
    "test:ui-code-editor": "node packages/elm-ui/tests/code-editor.test.js",
    "test:ui-chart": "node packages/elm-ui/tests/chart.test.js",
    "test:ui-list-field": "node packages/elm-ui/tests/list-field.test.js",
    "test:ui-suggest-input": "node packages/elm-ui/tests/suggest-input.test.js",
    "test:ui-menu-fit": "node packages/elm-ui/tests/menu-fit.test.js",
    "test:ui-form-errors": "node packages/elm-ui/tests/form-errors.test.js"
  },
  "devDependencies": {
    "@lydell/elm": "^0.19.1-14",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "elm-test": "^0.19.1-revision17",
    "glob": "^14.0.3",
    "html-webpack-plugin": "^5.6.8",
    "lodash": "^4.18.1",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "1.78.0",
    "sass-loader": "^17.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "uglify-js": "^3.19.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lezer/lr": "^1.4.10",
    "@tiptap/core": "^3.31.2",
    "@tiptap/extension-image": "^3.31.2",
    "@tiptap/extension-link": "^3.31.2",
    "@tiptap/extension-table": "^3.31.2",
    "@tiptap/extension-table-cell": "^3.31.2",
    "@tiptap/extension-table-header": "^3.31.2",
    "@tiptap/extension-table-row": "^3.31.2",
    "@tiptap/markdown": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "axios": "1.21.0",
    "axios-retry": "^4.5.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "driver.js": "^1.8.0",
    "flatpickr": "^4.6.13",
    "po2json": "^1.0.0-beta",
    "string_decoder": "^1.3.0",
    "util": "^0.12.5"
  }
}
