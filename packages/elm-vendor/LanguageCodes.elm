module LanguageCodes exposing (languages, options)

{-| ISO 639-1 two-letter language codes and their English names.

@docs languages, options

-}


{-| Form select options as `( code, "Name (code)" )` pairs, e.g.
`( "en", "English (en)" )`.
-}
options : List ( String, String )
options =
    List.map (\( code, name ) -> ( code, name ++ " (" ++ code ++ ")" )) languages


